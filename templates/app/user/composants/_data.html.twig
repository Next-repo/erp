<div class="table-responsive mb-0 p-0">
  <table class="table text-nowrap mb-0 align-middle table-hover">
    <thead class="text-dark">
      <tr>
        <th>Avatar</th>
        <th>Nom</th>
        <th>Email</th>
        <th>Roles</th>
        <th>Inscription</th>
        <th>Mise à jour</th>
        <th>actions</th>
      </tr>
    </thead>
    <tbody>
      {% for user in users %}
        <tr>
          <td><img src="{{user.avatarUrl ?? asset(userAvatar)}}" alt="{{user}}" width="35" class="rounded-2"></td>
          <td>{{ user.name }}</td>
          <td>{{ user.email }}</td>
          <td>{% include 'app/user/composants/_roles.html.twig' %}</td>
          <td>{{ user.created ? user.created|date('d/m/Y') : '' }}</td>
          <td>{{ user.updated ? user.updated|date('d/m/Y') : '' }}</td>
          <td>
						{% include "partials/button/_modale.html.twig" with {
									className: "edit",
									target: "editmodale",
									icon: "user",
									text: '',
									data: user,
									btn: "btn-sm btn-outline-primary",
									path: 'user_edit',
									condition: is_granted('ROLE_USER')}
								%}

						{% include "partials/button/_delete.html.twig" with {
									path: 'user_delete', 
									text: '',
									data: user,
									condition: is_granted('ROLE_USER')
									} %}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="7">no records found</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
