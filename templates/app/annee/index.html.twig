{% extends 'base.html.twig' %}

{% block title %}Années d'activitées ({{ annees.getTotalItemCount }})
{% endblock %}
{% block titre %}Années d'activitées ({{ annees.getTotalItemCount }})
{% endblock %}

{% block action %}{% endblock %}

{% block body %}

	<div class="card">
		<div class="card-header border-bottom">
			{% include "partials/app/_filter.html.twig" with {path: 'annees', clear: clear} %}
		</div>
		<div class="card-body">
			<div class="table-responsive mb-0 p-0">
				<table class="table text-nowrap mb-0 align-middle table-hover">
					<thead class="text-dark">
						<tr>
							<th>Désignation</th>
							<th>Entrées (Recettes)</th>
							<th>Sorties (Dépenses)</th>
							<th>Solde final</th>
							<th>Date d'ouverture</th>
							<th>Date de cloture</th>
							<th>Statut</th>
							<th>actions</th>
						</tr>
					</thead>
					<tbody>
						{% for annee in annees %}
							<tr>
								<td>{{ annee.name }}</td>
								<td>
									{% set totalEntrees = calculate(annee.entrees) %}
									<span class="{{badge('primary')}}">
										{{ totalEntrees|number_format(0, ' ', ' ') ~ ' ' ~ monnaie() }}
									</span>
								</td>
								<td>
									{% set totalSorties = calculate(annee.sorties) %}
									<span class="{{badge('warning')}}">
										{{ totalSorties|number_format(0, ' ', ' ') ~ ' ' ~ monnaie() }}
									</span>
								</td>
								<td>
									{% set soldeTotal = totalEntrees > 0 ? totalEntrees - totalSorties : 0 %}
									<span class="{{badge('success')}}">
										{{ soldeTotal|number_format(0, ' ', ' ') ~ ' ' ~ monnaie() }}
									</span>
								</td>
								<td>{{ annee.startAt ? annee.startAt|date('d/M/Y') : '' }}</td>
								<td>{{ annee.endAt ? annee.endAt|date('d/M/Y') : '' }}</td>
								<td><span class="{{badge(annee.statut)}}">{{ annee.statut }}</span></td>
								<td>
									{% if annee.statut == "En cours" %}
										{% include "partials/button/_modale.html.twig" with {
									className: "edit",
									target: "editModale", 
									icon: "pencil", 
									text: '', 
									data: annee, 
									btn: 'btn-sm btn-outline-primary', 
									path: 'annee_edit',
									condition: is_granted('ROLE_USER')
						} %}
									{% endif %}
									{% include "partials/button/_delete.html.twig" with {
										path: 'annee_delete', 
										data: annee, 
										condition: is_granted('ROLE_USER')
									} %}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="8">Aucune données</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
		<div class="card-footer">
			{% include "partials/app/_pagination.html.twig" with {data: annees} %}
		</div>
	</div>

	{% include "partials/app/_modale.html.twig" with {
		idElement: 'editModale',
		text: "Edition de l'année d'activitées",
		size: 'lg'}
	%}

{% endblock %}

{% block scripts %}
	{% include 'partials/app/_modale_scripts.html.twig' with {
		dataSelector: '.edit',
		modaleID: '#editModale'
	} %}
{% endblock %}
