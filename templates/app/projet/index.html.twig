{% extends 'base.html.twig' %}

{% block title %}Gestion de projets ({{ projets.getTotalItemCount }}){% endblock %}
{% block titre %}Gestion de projets ({{ projets.getTotalItemCount }}){% endblock %}

{% block action %}
	{% include "partials/button/_add_modale.html.twig" with {
		text: 'Nouveau projet',
		icon: 'plus',
		btn: "btn-primary"
	} %}
{% endblock %}

{% block right %}
	<div class="modal fade" id="addModal" {# data-bs-backdrop="static" #} tabindex="-1" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered modal-{{size is defined ? size : 'lg'}}" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h6 class="modal-title m-0" id="addModalLabel">
						{% include "partials/app/_logo.html.twig" with {size: 90} %}
						Nouveau projet
					</h6>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					{% set projet = projet ?? null %}
					<twig:Projets projet="{{projet}}"/>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block body %}

	<div class="card">
		<div class="card-header border-bottom">
			{% include "partials/app/_filter_simple.html.twig" with {path: 'projets', clear: clear} %}
		</div>
		<div class="card-body">
			{% include "app/projet/composants/_data.html.twig" with {data: projets} %}
		</div>
		<div class="card-footer">
			{% include "partials/app/_pagination.html.twig" with {data: projets} %}
		</div>
	</div>

	{% include "partials/app/_modale.html.twig" with {
		idElement: 'editmodale',
		text: "Détails projet",
		size: 'lg'}
	%}

{% endblock %}

{% block scripts %}
	{% include 'partials/app/_modale_scripts.html.twig' with {
		dataSelector: '.edit',
		modaleID: '#editmodale'
	} %}
{% endblock %}
