<div class="table-responsive mb-0 p-0">
	<table class="table text-nowrap mb-0 align-middle table-hover">
		<thead class="text-dark">
			<tr>
				<th>Nom du projet</th>
				<th>Date de début</th>
				<th>Date de cloture</th>
				<th>Budget estimatif</th>
				<th>Collaborateur</th>
				<th>Client</th>
				<th>Statut</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for projet in projets %}
				<tr>
					<td>
						{{ projet.name }}
					</td>
					<td>{{ projet.startAt|date('d/m/Y') }}</td>
					<td>{{ projet.endAt|date('d/m/Y') }}</td>
					<td><strong class="montant">{{projet.budget|number_format(0, ' ', ' ') ~ currency}}</strong></td>
					<td>{{projet.affectedTo}}</td>
					<td>{{projet.client}}</td>
					<td><span class="{{badge(projet.statut.value)}}">{{ projet.statut ? projet.statut.value : '' }}</span></td>
					<td>
						{% include "partials/button/_modale.html.twig" with {
									className: "edit",
									target: "editmodale",
									icon: "folder",
									text: '',
									data: projet,
									btn: "btn-sm btn-outline-primary",
									path: 'projet_edit',
									condition: is_granted('ROLE_USER')}
								%}

						{% include "partials/button/_delete.html.twig" with {
									path: 'projet_delete', 
									text: '',
									data: projet,
									condition: is_granted('ROLE_USER')
									} %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="8">Aucune données</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>
