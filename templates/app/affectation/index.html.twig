{% extends 'base.html.twig' %}

{% block title %}Gestion des affectation ({{ affectations.getTotalItemCount }}){% endblock %}
{% block titre %}Gestion des affectation ({{ affectations.getTotalItemCount }}){% endblock %}

{% block tabs %}{% endblock %}

{% block action %}
{% include "partials/button/_add_modale.html.twig" with {
add: 'Ajouter',
icon: 'plus',
btn: "btn-primary"
} %}
{% endblock %}

{% block right %}
<div class="modal fade" id="addModal" {# data-bs-backdrop="static" #} tabindex="-1" role="dialog"
  aria-labelledby="addModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-{{size is defined ? size : 'lg'}}" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title m-0" id="addModalLabel">
          {% include "partials/app/_logo.html.twig" with {size: 90} %}
          Nouveau rôle
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        {% set affectation = affectation ?? null %}
        <twig:Affectations role="{{affectation}}" />
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block body %}

<div class="card">
  <div class="card-header border-bottom">
    {% include "partials/app/_filter_simple.html.twig" with {path: 'affectations', clear: clear} %}
  </div>
  <div class="card-body">
    <div class="table-responsive mb-0 p-0">
      <table class="table text-nowrap mb-0 align-middle table-hover table-padding">
        <thead class="text-dark">
          <tr>
            <th>Membre</th>
            <th>Projet</th>
            <th>Rôle(s)</th>
            <th>Date</th>
            <th>actions</th>
          </tr>
        </thead>
        <tbody>
          {% for affectation in affectations %}
          <tr>
            <td>{{ affectation.user }}</td>
            <td>{{ affectation.projet }}</td>
            <td>
              {% for role in affectation.roles %}
                <span class="{{badge('success')}}">{{role}}</span>
              {% endfor %}
            </td>
            <td>{{ affectation.created ? affectation.created|date('d/m/Y') : '' }}</td>
            <td>
              {% include "partials/button/_modale.html.twig" with {
                className: "edit",
                target: "editmodale",
                icon: "pencil",
                text: '',
                data: affectation,
                path: 'affectation_edit'
              } %}
              {% include "partials/button/_delete.html.twig" with {
                path: 'affectation_delete',
                data: affectation
              } %}
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="5">no records found</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer border-top">
    {% include "partials/app/_pagination.html.twig" with {data: affectations} %}
  </div>
</div>

{% include "partials/app/_modale.html.twig" with {
idElement: 'editmodale',
text: "Détails affectation",
size: 'lg'}
%}

{% endblock %}

{% block scripts %}
{% include 'partials/app/_modale_scripts.html.twig' with {
dataSelector: '.edit',
modaleID: '#editmodale'
} %}
{% endblock %}