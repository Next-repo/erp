{% if condition is defined ? condition : is_granted('ROLE_CAN_ADD') %}

	<button aria-controls="offcanvasEnd" class="btn btn-primary {{btnsize ? btnsize : ''}}" data-bs-target="#{{target is defined ? target : 'offcanvasEnd'}}" data-bs-toggle="offcanvas" type="button">
		<i class="ti ti-{{icon is defined ? icon : 'plus'}}"></i>
		{{add is defined ? add : 'Ajouter'}}
	</button>

{% endif %}
