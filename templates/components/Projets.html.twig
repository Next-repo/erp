<div {{ attributes is defined ? attributes|raw:'' }}>
  {{ form_start(form, { attr: { 'data-action': 'live#action:prevent', 'data-live-action-param': 'save', class: 'app-form', projet: projet } }) }}

  {{ form_widget(form._token) }}
  {{ form_errors(form) }}

  <legend>Informations sur le projet</legend>
  <div class="grid-deux">
    {% if form.name is defined %}
      {{ form_row(form.name) }}
    {% endif %}

    {% if form.statut is defined %}
      {{ form_row(form.statut) }}
    {% endif %}

    {% if form.typePrestation is defined %}
      {{ form_row(form.typePrestation) }}
    {% endif %}

    {% if form.code is defined %}
      {{ form_row(form.code) }}
    {% endif %}

    {% if form.budget is defined %}
      {{ form_row(form.budget) }}
    {% endif %}

    {% if form.startAt is defined %}
      {{ form_row(form.startAt) }}
    {% endif %}

    {% if form.endAt is defined %}
      {{ form_row(form.endAt) }}
    {% endif %}
  </div>

  <legend>Affectation</legend>
  <div class="grid-deux">
    {% if form.affectedTo is defined %}
      {{ form_row(form.affectedTo) }}
    {% endif %}
  </div>

  <legend>Informations du client</legend>
  <div class="dash-grid-deux">
    {% if form.client is defined %}
      {{ form_row(form.client) }}
    {% endif %}
    {% if form.addClient is defined %}
      <div class="pt-4">{{ form_row(form.addClient) }}</div>
    {% endif %}
  </div>

  <div class="grid-deux">
    {% if form.nom is defined %}
      {{ form_row(form.nom) }}
    {% endif %}
    {% if form.type is defined %}
      {{ form_row(form.type) }}
    {% endif %}
    {% if form.email is defined %}
      {{ form_row(form.email) }}
    {% endif %}
    {% if form.telephone is defined %}
      {{ form_row(form.telephone) }}
    {% endif %}
  </div>

  {% if form.description is defined %}
    {{ form_row(form.description) }}
  {% endif %}

  <div class="pt-2">
    <button class="btn btn-primary" type="submit"><span class="loadBtn">Enregistrer</span></button>
  </div>
  {{ form_end(form, { render_rest: false }) }}
</div>
