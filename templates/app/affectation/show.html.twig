{% extends 'base.html.twig' %}

{% block title %}Affectation{% endblock %}

{% block body %}
    <h1>Affectation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ affectation.id }}</td>
            </tr>
            <tr>
                <th>Created</th>
                <td>{{ affectation.created ? affectation.created|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Updated</th>
                <td>{{ affectation.updated ? affectation.updated|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('affectations') }}">back to list</a>

    <a href="{{ path('affectation_edit', {'id': affectation.id}) }}">edit</a>

    {{ include('app/affectation/_delete_form.html.twig') }}
{% endblock %}
