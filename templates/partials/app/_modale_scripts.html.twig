<script>

  $("{{dataSelector is defined ? dataSelector : '.details'}}").click(function () {
    let url = $(this).data("url");
    let loader = `<div class="text-center"><div class="spinner-border text-primary" role="status">
                      <span class="visually-hidden">Loading...</span>
                    </div></div>`;

    $("{{modaleID is defined ? modaleID : '#ModaleDetails'}}").find(".details-body").html(loader);

    $.ajax({
      type: "GET",
      url: url,
      cache: false,
      success: function (data) {
        $("{{modaleID is defined ? modaleID : '#ModaleDetails'}}").find(".details-body").html(data);
        $("{{modaleID is defined ? modaleID : '#ModaleDetails'}}").find("form").attr("action", url);
      },
      error: function (e) {
        console.log("ERROR : ", e);
      }
    });
  });
</script>
