{% extends 'base.html.twig' %}

{% block title %}Annee{% endblock %}

{% block body %}
    <h1>Annee</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>#ID</th>
                <td>{{ annee.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ annee.name }}</td>
            </tr>
            <tr>
                <th>ObjectGeneral</th>
                <td>{{ annee.objectGeneral }}</td>
            </tr>
            <tr>
                <th>Currente</th>
                <td>{{ annee.currente ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ annee.statut }}</td>
            </tr>
            <tr>
                <th>StartAt</th>
                <td>{{ annee.startAt ? annee.startAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>EndAt</th>
                <td>{{ annee.endAt ? annee.endAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Created</th>
                <td>{{ annee.created ? annee.created|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Updated</th>
                <td>{{ annee.updated ? annee.updated|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('annees') }}">back to list</a>

    <a href="{{ path('annee_edit', {'id': annee.id}) }}">edit</a>

    {{ include('app/annee/_delete_form.html.twig') }}
{% endblock %}
