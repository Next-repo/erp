{% extends 'base.html.twig' %}

{% block title %}Mon compte
{% endblock %}
{% block titre %}Mon compte
{% endblock %}
{% block action %}{% endblock %}

{% block body %}
	<div class="card overflow-hidden profil-card">
		<div class="card-body">
			<div class="banner"></div>
			<div class="row align-items-center mb-3">
				<div class="col-lg-4 text-center mt-n3">
					<div class="mt-n5 ps-3">
						<div class="d-flex align-items-center justify-content-start mb-2">
							<div class="d-flex align-items-center justify-content-start round-110">
								<div class="grid-img d-flex align-items-center justify-content-start rounded-circle round-100">
									{% include "partials/user/_avatar.html.twig" with {user: user, width: '100%'} %}
								</div>
							</div>
						</div>
						<div class="text-start">
							<h5 class="mb-0">{{user}}</h5>
							<span class="d-block">{{user.email}}</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<ul class="nav nav-pills user-profile-tab mb-3" id="pills-tab" role="tablist">
		<li class="nav-item" role="presentation">
			<button class="nav-link position-relative rounded-0 d-flex align-items-center justify-content-center bg-transparent fs-3 py-3 active" id="pills-compte-tab" data-bs-toggle="pill" data-bs-target="#pills-compte" type="button" role="tab" aria-controls="pills-compte" aria-selected="true">
				<i class="ti ti-user me-1"></i>
				<span class="d-none d-md-block">Profil</span>
			</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link position-relative rounded-0 d-flex align-items-center justify-content-center bg-transparent fs-3 py-3" id="pills-access-tab" data-bs-toggle="pill" data-bs-target="#pills-access" type="button" role="tab" aria-controls="pills-access" aria-selected="false" tabindex="-1">
				<span class="d-none d-md-block">Mes accès</span>
			</button>
		</li>
	</ul>
	<div class="tab-content" id="pills-tabContent">
		<div class="tab-pane fade active show" id="pills-compte" role="tabpanel" aria-labelledby="pills-compte-tab" tabindex="0">
			<div class="card card-body">
				<h5 class="pb-3">Profil</h5>
				{{ form_start(form) }}
				<div class="grid-deux">
					{{ form_row(form.name) }}
					{{ form_row(form.email) }}
				</div>
				{{ form_rest(form) }}
				<div class="pt-2">
					<button class="btn btn-primary" type="submit">
						<span class="loadBtn">{{ button_label|default('Mettre à jour') }}</span>
					</button>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
		<div class="tab-pane fade" id="pills-access" role="tabpanel" aria-labelledby="pills-access-tab" tabindex="0">
			<div class="card card-body">
				<h5 class="pb-3">Mettre à jour mes accès</h5>
				{{ form_start(resetForm) }}
				<div class="grid-deux">
					{{ form_row(resetForm.plainPassword) }}
				</div>
				{{ form_rest(resetForm) }}
				<div class="pt-2">
					<button class="btn btn-primary" type="submit">
						<span class="loadBtn">{{ button_label|default('Mettre à jour') }}</span>
					</button>
				</div>
				{{ form_end(resetForm) }}
			</div>
		</div>
	</div>

{% endblock %}
